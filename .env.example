# API Keys (optional for replay, required for live discovery)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Configuration
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o

# Target Application
TARGET_APP_URL=http://localhost:8080
MAX_AGENT_STEPS=20
AGENT_TIMEOUT_SECONDS=300

# Safety Guardrails
ALLOWED_DOMAINS=localhost,127.0.0.1
ALLOWED_ACTION_TYPES=navigate,click,type,extract,wait
RISKY_ACTION_TYPES=submit,confirm

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs